---
import Navigation from './navigation.astro';
import Menu from './Menu.astro';
import ThemeIcon from './ThemeIcon.astro';
---
<header>
	<div class="barra">
		<ThemeIcon />
		<Menu />
	</div>
	<nav>
		<Navigation />
	</nav>
</header>

<style>
	header {
		border-bottom: 2px solid currentColor;
		padding-bottom: 0.5rem;
	}
	.barra {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
</style>
