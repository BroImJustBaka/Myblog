<style>
	footer {
		margin-top: 2rem;
		padding: 1rem 0;
		border-top: 2px solid black;
	}
	.redes {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
	}
</style>
