	<div class="redes">
		<Social plataforma="github" usuario="BroImJustBaka" chiste="(aquí sí hay código, lo juro)" />
		<Social plataforma="youtube" usuario="astrodotbuild" chiste="(no tengo canal, presto el de Astro)" />
		<Social plataforma="twitter" usuario="astrodotbuild" chiste="(tampoco tengo, ni falta)" />
