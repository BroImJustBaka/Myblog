---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';

const publicaciones = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "el mero blog";
---
<BaseLayout pageTitle={pageTitle}>
	<h2>Super proyectadas chingonas</h2>
	<p>Ayuda no me siento bien</p>
	<p>Estas son todas mis publicaciones. Sí, las escribí yo solito y nadie me lo pidió.</p>
	<ul>
		{publicaciones.map((p: any) => <BlogPost enlace={p.url} titulo={p.frontmatter.title} />)}
	</ul>
</BaseLayout>
