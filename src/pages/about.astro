---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Sobre mi";

const identity = {
	fullName: "Santiago Becerra Arias",
	registro: "23300648",
	country: "México",
	occupation: "Programador",
	hobbies: ["basquetball", "música", "gym"],
};

const skills = [
	"HTML",
	"CSS",
	"JavaScript",
	"React",
	"Astro",
	"Redacción de documentos",
	"Claude Code",
];

const happy = false;
const finished = true;
const goal = 8;

const operatingSystem: string = "Windows";
const quantity = 3;
const footwear = "botas";
const student = false;

const skillColor = "crimson";
---

<BaseLayout pageTitle={pageTitle}>
	<h2>Hola mira que bonito está mi blog</h2>
	<p>
		Trato de hacer una práctica de kegovc a mano y le añadiré más
		mierdas
	</p>

	<p>
		me presento, me llamo {identity.fullName}, registro {identity.registro},
		trabajo como {identity.occupation} y me gusta:
	</p>
	{
		identity.hobbies.length >= 2 && (
			<p>
				Dos de mis aficiones son: {identity.hobbies[0]} y la{" "}
				{identity.hobbies[1]}
			</p>
		)
	}

	<p>le se así bien vergas a:</p>
	<ul>
		{skills.map((skill) => <li class="skill">{skill}</li>)}
	</ul>

	{happy ? <p>¡Estoy feliz de aprender Astro!</p> : <p>alguien mateme</p>}

	{finished && <p>¡He terminado este tutorial!</p>}

	{
		goal === 8 ? (
			<p>Mi objetivo es terminar máximo a las 8 wey.</p>
		) : (
			<p>KEGOVC EXTENDIÓ LA FECHA YUJU.</p>
		)
	}
	<p>{operatingSystem}</p>
	{student && <p>ayuda tengo clases con kegovc</p>}
	<p>ayuda tengo {quantity + 8} pares de {footwear}</p>
	{
		operatingSystem === "MacOS" ? (
			<p>soy gay</p>
		) : (
			<p>No utilizo un Mac.</p>
		)
	}

	<style define:vars={{skillColor}}>
		.skill {
			color: var(--skillColor);
			font-weight: bold;
		}
	</style>
</BaseLayout>
