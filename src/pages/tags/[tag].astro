---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost.astro';

export async function getStaticPaths() {
	const publicaciones = Object.values(import.meta.glob('../posts/*.md', { eager: true }));
	const etiquetas = [...new Set(publicaciones.flatMap((p: any) => p.frontmatter.tags))];

	return etiquetas.map((tag) => ({
		params: { tag },
		props: {
			coincidencias: publicaciones.filter((p: any) => p.frontmatter.tags.includes(tag)),
		},
	}));
}

const { tag } = Astro.params;
const { coincidencias } = Astro.props;
---
<BaseLayout pageTitle={`Etiqueta: ${tag}`}>
	<p>Publicaciones que se atrevieron a llamarse "{tag}":</p>
	<ul>
		{coincidencias.map((p: any) => <BlogPost enlace={p.url} titulo={p.frontmatter.title} />)}
	</ul>
</BaseLayout>
